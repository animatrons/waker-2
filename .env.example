# Copy to `.env` and adjust locally. Never commit real secrets.
# `.env` is gitignored.

POSTGRES_USER=waker
POSTGRES_PASSWORD=changeme
POSTGRES_DB=waker
# Host port only (container stays on 5432). Use 5433 if local Postgres already owns 5432.
POSTGRES_PORT=5433

# JDBC URL uses the Compose service hostname `postgres` when running via docker compose.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/waker
SPRING_DATASOURCE_USERNAME=waker
SPRING_DATASOURCE_PASSWORD=changeme

SERVER_PORT=8080

# HS256 signing key — use a long random string (≥32 chars). Never commit real values.
WAKER_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Optional override (Spring Duration). Default 1h.
# WAKER_JWT_EXPIRATION=1h

# Auth login/register throttle (in-memory, single instance). Not secrets.
# WAKER_RATE_LIMIT_CAPACITY=10
# WAKER_RATE_LIMIT_WINDOW=15m

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Mail — local Mailpit (Compose service hostname when app runs in Compose)
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
WAKER_MAIL_FROM=waker@localhost

# Production only (never commit real token):
# SPRING_PROFILES_ACTIVE=prod
# POSTMARK_SERVER_TOKEN=
# WAKER_MAIL_FROM=penalties@your-verified-domain
